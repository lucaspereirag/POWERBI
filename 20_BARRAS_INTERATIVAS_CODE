.sla-tooltip {
    position: absolute;
    top: 8px;
    z-index: 50;
    width: 214px;
    padding: 12px;
    visibility: hidden;
    opacity: 0;
    pointer-events: none;
    color: " & cor_texto_principal & ";
    background: rgba(255,255,255,0.99);
    border: 1px solid " & cor_borda & ";
    border-radius: 13px;
    box-shadow:
        0 14px 32px rgba(15,23,42,0.15),
        0 3px 8px rgba(15,23,42,0.06);
    transition:
        opacity 150ms ease,
        transform 150ms ease,
        visibility 150ms ease;
}

.sla-tooltip::after {
    content: '';
    position: absolute;
    bottom: -6px;
    width: 11px;
    height: 11px;
    background: #FFFFFF;
    border-right: 1px solid " & cor_borda & ";
    border-bottom: 1px solid " & cor_borda & ";
    transform: rotate(45deg);
}

.sla-tip-left .sla-tooltip {
    left: 0;
    transform: translateY(7px);
}

.sla-tip-left .sla-tooltip::after {
    left: 30px;
}

.sla-tip-center .sla-tooltip {
    left: 50%;
    transform: translate(-50%, 7px);
}

.sla-tip-center .sla-tooltip::after {
    left: 50%;
    margin-left: -6px;
}

.sla-tip-right .sla-tooltip {
    right: 0;
    transform: translateY(7px);
}

.sla-tip-right .sla-tooltip::after {
    right: 30px;
}

.sla-tip-left:hover .sla-tooltip,
.sla-tip-left:focus .sla-tooltip,
.sla-tip-right:hover .sla-tooltip,
.sla-tip-right:focus .sla-tooltip {
    visibility: visible;
    opacity: 1;
    transform: translateY(0);
}

.sla-tip-center:hover .sla-tooltip,
.sla-tip-center:focus .sla-tooltip {
    visibility: visible;
    opacity: 1;
    transform: translate(-50%, 0);
}

.sla-tooltip-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 9px;
    padding-bottom: 10px;
    border-bottom: 1px solid #E9EEF5;
}

.sla-tooltip-title {
    min-width: 0;
    overflow: hidden;
    color: " & cor_texto_principal & ";
    font-size: 12px;
    font-weight: 700;
    line-height: 1.25;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.sla-tooltip-status {
    flex: 0 0 auto;
    padding: 4px 8px;
    border-radius: 999px;
    font-size: 9px;
    font-weight: 700;
    line-height: 1.2;
    white-space: nowrap;
}

.sla-tooltip-values {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 10px;
    padding: 11px 0;
}

.sla-tooltip-metric {
    min-width: 0;
}

.sla-tooltip-label {
    display: block;
    margin-bottom: 4px;
    color: " & cor_texto_secundario & ";
    font-size: 9.5px;
    font-weight: 500;
    line-height: 1.2;
}

.sla-tooltip-number {
    display: block;
    color: " & cor_texto_principal & ";
    font-size: 16px;
    font-weight: 700;
    line-height: 1.1;
    font-variant-numeric: tabular-nums;
}

.sla-tooltip-footer {
    padding-top: 9px;
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 10px;
    border-top: 1px solid #E9EEF5;
}

.sla-tooltip-footer-item {
    min-width: 0;
}

.sla-tooltip-footer-item:last-child {
    text-align: right;
}

.sla-tooltip-footer-label {
    display: block;
    margin-bottom: 3px;
    color: " & cor_texto_secundario & ";
    font-size: 9px;
    font-weight: 500;
    line-height: 1.2;
}

.sla-tooltip-footer-value {
