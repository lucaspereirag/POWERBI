// ---------------------------------------------------------
// 🟩 [PASSO 1] - CONFIGURE SEUS DADOS
// ---------------------------------------------------------

-- Textos do visual
VAR titulo_card    = "Cumprimento de SLA por central"                       -- Título principal do visual
VAR subtitulo_card = "Percentual de chamados resolvidos dentro do prazo"    -- Descrição exibida abaixo do título

-- Valores do período atual
VAR percentual_central_sul   = 0.92                                         -- <--- CONECTE A MEDIDA ATUAL DA CENTRAL SUL AQUI
VAR percentual_central_norte = 0.74                                         -- <--- CONECTE A MEDIDA ATUAL DA CENTRAL NORTE AQUI
VAR percentual_central_leste = 0.48                                         -- <--- CONECTE A MEDIDA ATUAL DA CENTRAL LESTE AQUI

-- Valores do mês anterior
VAR percentual_central_sul_anterior   = 0.89                                -- <--- CONECTE A MEDIDA ANTERIOR DA CENTRAL SUL AQUI
VAR percentual_central_norte_anterior = 0.77                                -- <--- CONECTE A MEDIDA ANTERIOR DA CENTRAL NORTE AQUI
VAR percentual_central_leste_anterior = 0.55                                -- <--- CONECTE A MEDIDA ANTERIOR DA CENTRAL LESTE AQUI

-- Limites de classificação
VAR limite_saudavel = 0.85                                                  -- Resultado igual ou superior será classificado como saudável
VAR limite_atencao  = 0.60                                                  -- Resultado igual ou superior será classificado como atenção


// ---------------------------------------------------------
// 🟨 [PASSO 2] - PERSONALIZE O DESIGN (OPCIONAL)
// ---------------------------------------------------------

-- Cores semânticas
VAR cor_saudavel  = "#4CCA82"                                               -- Cor principal para status saudável
VAR cor_atencao   = "#ED6C15"                                               -- Cor principal para status de atenção
VAR cor_critico   = "#D11D17"                                               -- Cor principal para status crítico
VAR cor_sem_dados = "#CBD5E1"                                               -- Cor principal quando não houver dados

-- Cores dos textos de status
VAR cor_texto_saudavel  = "#166534"                                         -- Cor do texto para status saudável
VAR cor_texto_atencao   = "#9A3F00"                                         -- Cor do texto para status de atenção
VAR cor_texto_critico   = "#A21814"                                         -- Cor do texto para status crítico
VAR cor_texto_sem_dados = "#64748B"                                         -- Cor do texto quando não houver dados

-- Cores dos fundos de status
VAR cor_fundo_saudavel  = "#ECFDF3"                                         -- Fundo do status saudável
VAR cor_fundo_atencao   = "#FFF4E8"                                         -- Fundo do status de atenção
VAR cor_fundo_critico   = "#FFF0EF"                                         -- Fundo do status crítico
VAR cor_fundo_sem_dados = "#F1F5F9"                                         -- Fundo quando não houver dados

-- Cores da interface
VAR cor_texto_principal  = "#0F172A"                                        -- Cor do texto principal
VAR cor_texto_secundario = "#64748B"                                        -- Cor dos textos secundários
VAR cor_texto_suave      = "#64748B"                                        -- Cor dos textos auxiliares e do eixo
VAR cor_borda            = "#E2E8F0"                                        -- Cor da borda externa
VAR cor_fundo_card       = "#FFFFFF"                                        -- Cor de fundo do card
VAR cor_fundo_grafico    = "#FBFCFD"                                        -- Cor de fundo da área do gráfico
VAR cor_fundo_track      = "rgba(255,255,255,0.94)"                         -- Cor de fundo das trilhas das barras
VAR cor_linha_grade      = "rgba(100,116,139,0.30)"                         -- Cor das linhas de referência


// ---------------------------------------------------------
// 🚫 LÓGICA DO SISTEMA (NÃO ALTERAR ABAIXO)
// ---------------------------------------------------------

/* =========================================================
   QUANTIDADE DE CENTRAIS COM DADOS
   ========================================================= */

VAR QtdCentraisAtual =
      IF ( NOT ISBLANK ( percentual_central_sul ), 1, 0 )
    + IF ( NOT ISBLANK ( percentual_central_norte ), 1, 0 )
    + IF ( NOT ISBLANK ( percentual_central_leste ), 1, 0 )

VAR QtdCentraisAnterior =
      IF ( NOT ISBLANK ( percentual_central_sul_anterior ), 1, 0 )
    + IF ( NOT ISBLANK ( percentual_central_norte_anterior ), 1, 0 )
    + IF ( NOT ISBLANK ( percentual_central_leste_anterior ), 1, 0 )

/* =========================================================
   MÉDIAS
   ========================================================= */

VAR MediaAtual =
    DIVIDE (
          COALESCE ( percentual_central_sul, 0 )
        + COALESCE ( percentual_central_norte, 0 )
        + COALESCE ( percentual_central_leste, 0 ),
        QtdCentraisAtual
    )

VAR MediaAnterior =
    DIVIDE (
          COALESCE ( percentual_central_sul_anterior, 0 )
        + COALESCE ( percentual_central_norte_anterior, 0 )
        + COALESCE ( percentual_central_leste_anterior, 0 ),
        QtdCentraisAnterior
    )

/* =========================================================
   VARIAÇÕES PERCENTUAIS RELATIVAS

   Fórmula:
   (atual - anterior) / anterior
   ========================================================= */

VAR VariacaoSulPct =
    IF (
        OR (
            ISBLANK ( percentual_central_sul ),
            ISBLANK ( percentual_central_sul_anterior )
        ),
        BLANK (),
        DIVIDE (
            percentual_central_sul - percentual_central_sul_anterior,
            percentual_central_sul_anterior
        )
    )

VAR VariacaoNortePct =
    IF (
        OR (
            ISBLANK ( percentual_central_norte ),
            ISBLANK ( percentual_central_norte_anterior )
        ),
        BLANK (),
        DIVIDE (
            percentual_central_norte - percentual_central_norte_anterior,
            percentual_central_norte_anterior
        )
    )

VAR VariacaoLestePct =
    IF (
        OR (
            ISBLANK ( percentual_central_leste ),
            ISBLANK ( percentual_central_leste_anterior )
        ),
        BLANK (),
        DIVIDE (
            percentual_central_leste - percentual_central_leste_anterior,
            percentual_central_leste_anterior
        )
    )

VAR VariacaoMediaPct =
    IF (
        OR (
            ISBLANK ( MediaAtual ),
            ISBLANK ( MediaAnterior )
        ),
        BLANK (),
        DIVIDE (
            MediaAtual - MediaAnterior,
            MediaAnterior
        )
    )

/* =========================================================
   STATUS DAS CENTRAIS
   ========================================================= */

VAR StatusSul =
    SWITCH (
        TRUE (),
        ISBLANK ( percentual_central_sul ), "Sem dados",
        percentual_central_sul >= limite_saudavel, "Saudável",
        percentual_central_sul >= limite_atencao, "Atenção",
        "Crítico"
    )

VAR StatusNorte =
    SWITCH (
        TRUE (),
        ISBLANK ( percentual_central_norte ), "Sem dados",
        percentual_central_norte >= limite_saudavel, "Saudável",
        percentual_central_norte >= limite_atencao, "Atenção",
        "Crítico"
    )

VAR StatusLeste =
    SWITCH (
        TRUE (),
        ISBLANK ( percentual_central_leste ), "Sem dados",
        percentual_central_leste >= limite_saudavel, "Saudável",
        percentual_central_leste >= limite_atencao, "Atenção",
        "Crítico"
    )

/* =========================================================
   CORES DAS BARRAS
   ========================================================= */

VAR CorSul =
    SWITCH (
        StatusSul,
        "Saudável", cor_saudavel,
        "Atenção", cor_atencao,
        "Crítico", cor_critico,
        cor_sem_dados
    )

VAR CorNorte =
    SWITCH (
        StatusNorte,
        "Saudável", cor_saudavel,
        "Atenção", cor_atencao,
        "Crítico", cor_critico,
        cor_sem_dados
    )

VAR CorLeste =
    SWITCH (
        StatusLeste,
        "Saudável", cor_saudavel,
        "Atenção", cor_atencao,
        "Crítico", cor_critico,
        cor_sem_dados
    )

/* =========================================================
   CORES DOS STATUS NO TOOLTIP
   ========================================================= */

VAR CorTextoStatusSul =
    SWITCH (
        StatusSul,
        "Saudável", cor_texto_saudavel,
        "Atenção", cor_texto_atencao,
        "Crítico", cor_texto_critico,
        cor_texto_sem_dados
    )

VAR CorTextoStatusNorte =
    SWITCH (
        StatusNorte,
        "Saudável", cor_texto_saudavel,
        "Atenção", cor_texto_atencao,
        "Crítico", cor_texto_critico,
        cor_texto_sem_dados
    )

VAR CorTextoStatusLeste =
    SWITCH (
        StatusLeste,
        "Saudável", cor_texto_saudavel,
        "Atenção", cor_texto_atencao,
        "Crítico", cor_texto_critico,
        cor_texto_sem_dados
    )

VAR CorFundoStatusSul =
    SWITCH (
        StatusSul,
        "Saudável", cor_fundo_saudavel,
        "Atenção", cor_fundo_atencao,
        "Crítico", cor_fundo_critico,
        cor_fundo_sem_dados
    )

VAR CorFundoStatusNorte =
    SWITCH (
        StatusNorte,
        "Saudável", cor_fundo_saudavel,
        "Atenção", cor_fundo_atencao,
        "Crítico", cor_fundo_critico,
        cor_fundo_sem_dados
    )

VAR CorFundoStatusLeste =
    SWITCH (
        StatusLeste,
        "Saudável", cor_fundo_saudavel,
        "Atenção", cor_fundo_atencao,
        "Crítico", cor_fundo_critico,
        cor_fundo_sem_dados
    )

/* =========================================================
   VALORES FORMATADOS
   ========================================================= */

VAR TxtSul =
    IF (
        ISBLANK ( percentual_central_sul ),
        "—",
        FORMAT ( percentual_central_sul, "0%" )
    )

VAR TxtNorte =
    IF (
        ISBLANK ( percentual_central_norte ),
        "—",
        FORMAT ( percentual_central_norte, "0%" )
    )

VAR TxtLeste =
    IF (
        ISBLANK ( percentual_central_leste ),
        "—",
        FORMAT ( percentual_central_leste, "0%" )
    )

VAR TxtSulAnterior =
    IF (
        ISBLANK ( percentual_central_sul_anterior ),
        "—",
        FORMAT ( percentual_central_sul_anterior, "0%" )
    )

VAR TxtNorteAnterior =
    IF (
        ISBLANK ( percentual_central_norte_anterior ),
        "—",
        FORMAT ( percentual_central_norte_anterior, "0%" )
    )

VAR TxtLesteAnterior =
    IF (
        ISBLANK ( percentual_central_leste_anterior ),
        "—",
        FORMAT ( percentual_central_leste_anterior, "0%" )
    )

VAR TxtMediaAtual =
    IF (
        ISBLANK ( MediaAtual ),
        "—",
        FORMAT ( MediaAtual, "0%" )
    )

VAR TxtMeta =
    FORMAT ( limite_saudavel, "0%" )

/* =========================================================
   ALTURAS DAS BARRAS
   ========================================================= */

VAR AlturaSul =
    IF (
        ISBLANK ( percentual_central_sul ),
        "0%",
        FORMAT (
            MAX (
                0,
                MIN ( percentual_central_sul, 1 )
            ),
            "0%"
        )
    )

VAR AlturaNorte =
    IF (
        ISBLANK ( percentual_central_norte ),
        "0%",
        FORMAT (
            MAX (
                0,
                MIN ( percentual_central_norte, 1 )
            ),
            "0%"
        )
    )

VAR AlturaLeste =
    IF (
        ISBLANK ( percentual_central_leste ),
        "0%",
        FORMAT (
            MAX (
                0,
                MIN ( percentual_central_leste, 1 )
            ),
            "0%"
        )
    )

/* =========================================================
   TEXTOS DAS VARIAÇÕES PERCENTUAIS
   ========================================================= */

VAR TxtDeltaSul =
    SWITCH (
        TRUE (),
        ISBLANK ( VariacaoSulPct ),
            "Sem comparação",
        VariacaoSulPct > 0,
            "▲ +" & FORMAT ( ABS ( VariacaoSulPct ), "0.0%" ),
        VariacaoSulPct < 0,
            "▼ -" & FORMAT ( ABS ( VariacaoSulPct ), "0.0%" ),
        "• 0,0%"
    )

VAR TxtDeltaNorte =
    SWITCH (
        TRUE (),
        ISBLANK ( VariacaoNortePct ),
            "Sem comparação",
        VariacaoNortePct > 0,
            "▲ +" & FORMAT ( ABS ( VariacaoNortePct ), "0.0%" ),
        VariacaoNortePct < 0,
            "▼ -" & FORMAT ( ABS ( VariacaoNortePct ), "0.0%" ),
        "• 0,0%"
    )

VAR TxtDeltaLeste =
    SWITCH (
        TRUE (),
        ISBLANK ( VariacaoLestePct ),
            "Sem comparação",
        VariacaoLestePct > 0,
            "▲ +" & FORMAT ( ABS ( VariacaoLestePct ), "0.0%" ),
        VariacaoLestePct < 0,
            "▼ -" & FORMAT ( ABS ( VariacaoLestePct ), "0.0%" ),
        "• 0,0%"
    )

VAR TxtDeltaMedia =
    SWITCH (
        TRUE (),
        ISBLANK ( VariacaoMediaPct ),
            "Sem comparação mensal",
        VariacaoMediaPct > 0,
            "▲ +" & FORMAT ( ABS ( VariacaoMediaPct ), "0.0%" )
                & " vs. mês anterior",
        VariacaoMediaPct < 0,
            "▼ -" & FORMAT ( ABS ( VariacaoMediaPct ), "0.0%" )
                & " vs. mês anterior",
        "• Estável vs. mês anterior"
    )

/* =========================================================
   CORES DAS VARIAÇÕES
   ========================================================= */

VAR CorDeltaSul =
    SWITCH (
        TRUE (),
        ISBLANK ( VariacaoSulPct ), cor_texto_sem_dados,
        VariacaoSulPct > 0, cor_texto_saudavel,
        VariacaoSulPct < 0, cor_texto_critico,
        cor_texto_sem_dados
    )

VAR CorDeltaNorte =
    SWITCH (
        TRUE (),
        ISBLANK ( VariacaoNortePct ), cor_texto_sem_dados,
        VariacaoNortePct > 0, cor_texto_saudavel,
        VariacaoNortePct < 0, cor_texto_critico,
        cor_texto_sem_dados
    )

VAR CorDeltaLeste =
    SWITCH (
        TRUE (),
        ISBLANK ( VariacaoLestePct ), cor_texto_sem_dados,
        VariacaoLestePct > 0, cor_texto_saudavel,
        VariacaoLestePct < 0, cor_texto_critico,
        cor_texto_sem_dados
    )

/* =========================================================
   TAG DE VARIAÇÃO GERAL
   ========================================================= */

VAR CorChipFundo =
    SWITCH (
        TRUE (),
        ISBLANK ( VariacaoMediaPct ), cor_fundo_sem_dados,
        VariacaoMediaPct > 0, cor_fundo_saudavel,
        VariacaoMediaPct < 0, cor_fundo_critico,
        cor_fundo_sem_dados
    )

VAR CorChipTexto =
    SWITCH (
        TRUE (),
        ISBLANK ( VariacaoMediaPct ), cor_texto_sem_dados,
        VariacaoMediaPct > 0, cor_texto_saudavel,
        VariacaoMediaPct < 0, cor_texto_critico,
        cor_texto_sem_dados
    )

/* =========================================================
   TEXTOS DE ACESSIBILIDADE
   ========================================================= */

VAR AriaSul =
    "Central Sul. SLA atual "
        & TxtSul
        & ". Status "
        & StatusSul
        & ". Variação percentual "
        & TxtDeltaSul
        & "."

VAR AriaNorte =
    "Central Norte. SLA atual "
        & TxtNorte
        & ". Status "
        & StatusNorte
        & ". Variação percentual "
        & TxtDeltaNorte
        & "."

VAR AriaLeste =
    "Central Leste. SLA atual "
        & TxtLeste
        & ". Status "
        & StatusLeste
        & ". Variação percentual "
        & TxtDeltaLeste
        & "."

